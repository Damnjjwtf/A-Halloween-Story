# Postgres connection string (Vercel Postgres / Neon: use the pooled URL here)
DATABASE_URL="postgresql://user:password@host:5432/structure_lab"

# Shared passphrase for the Gate. Distribute to JJ and Stefan out of band.
GATE_PASSPHRASE="choose-a-passphrase"

# Secret used to HMAC-sign the session cookie. Any long random string.
SESSION_SECRET="generate-a-long-random-string"

# Anthropic API key for the Lab's pairing engine. Server-side only.
ANTHROPIC_API_KEY="sk-ant-..."

# Optional: override the synthesis model (default claude-sonnet-4-6).
# ANTHROPIC_MODEL="claude-sonnet-4-6"
